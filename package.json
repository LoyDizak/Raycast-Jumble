{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "jumble",
  "title": "Jumble",
  "description": "Find apps after typing a query with the wrong keyboard layout.",
  "icon": "extension-icon.png",
  "author": "community",
  "platforms": ["Windows"],
  "categories": ["Productivity"],
  "license": "MIT",
  "preferences": [
    {
      "name": "conversionDirection",
      "title": "Conversion Direction",
      "description": "Automatically detect conversion direction, or choose a specific direction.",
      "type": "dropdown",
      "required": true,
      "default": "auto",
      "data": [
        { "title": "Automatic (Recommended)", "value": "auto" },
        { "title": "Selected Layout → English", "value": "toEnglish" },
        { "title": "English → Selected Layout", "value": "fromEnglish" }
      ]
    },
    {
      "name": "layoutMode",
      "title": "Source Keyboard Layout",
      "description": "Automatically detect a source layout. For English-to-layout conversion, choose the target layout.",
      "type": "dropdown",
      "required": true,
      "default": "auto",
      "data": [
        { "title": "Automatic (Recommended)", "value": "auto" },
        { "title": "Russian — ЙЦУКЕН", "value": "russian" },
        { "title": "Ukrainian — ЙЦУКЕН", "value": "ukrainian" },
        { "title": "French — AZERTY", "value": "french" },
        { "title": "German — QWERTZ", "value": "german" },
        { "title": "Greek", "value": "greek" }
      ]
    }
  ],
  "commands": [
    {
      "name": "fix-layout",
      "title": "Fix Keyboard Layout",
      "description": "Convert a query typed in the wrong keyboard layout and find applications or search the web.",
      "icon": "extension-icon.png",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.7.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "format": "prettier --write src"
  }
}
